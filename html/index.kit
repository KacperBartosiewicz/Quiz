<!DOCTYPE html>
<html lang="pl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <!-- @include 'styles.kit' -->
</head>

<body>
    <div class=" quiz quiz-container">
        <div class="quiz__page" data-number="1">
            <h1 class="quiz__page-title">Quizomania</h1>
            <div class="quiz__form">
                <label for="text">Jak się nazywasz? 😃</label>
                <input class="quiz__form-name" type="text" placeholder="Podaj imię">
                <p class="quiz-error">Imię musi się składać z conajmniej 3 znaków</p>
            </div>
            <button class="btn btn-next">Next</button>
        </div>
        <div class="quiz__page quiz-active" data-number="2">
            <h2 class="quiz-title">Wybierz poziom trudności</h2>
            <div class="quiz__buttons">
                <button class=" quiz__buttons-btn easy">
                    <div class="quiz__buttons-top quiz__buttons-top--easy">Łatwy</div>
                    <div class="quiz__buttons-bottom quiz__buttons-bottom--easy "></div>
                </button>
                <button class="quiz__buttons-btn hard">
                    <div class="quiz__buttons-top quiz__buttons-top--hard">Trudny</div>
                    <div class="quiz__buttons-bottom quiz__buttons-bottom--hard "></div>
                </button>
            </div>
        </div>
        <!-- @include 'easyQuiz.kit' -->

    </div>
    <!-- @include 'easyProgress.kit' -->
    <!-- @include 'hardProgress.kit' -->



    <script src="./dist/js/main.min.js"></script>
</body>

</html>